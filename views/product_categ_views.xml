<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="view_product_categ_tree" model="ir.ui.view">
            <field name="name">product_categ_tree</field>
            <field name="model">product.categ</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name" string="STT" optional="show" readonly="1"/>
                </tree>
            </field>
        </record>


        <record id="action_product_categ" model="ir.actions.act_window">
            <field name="name">product categ</field>
            <field name="res_model">product.categ</field>
            <field name="view_mode">tree</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Tạo categ
                </p>
            </field>
        </record>

    </data>
</odoo>
