<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="view_product_categ_tree" model="ir.ui.view">
            <field name="name">product_categ_tree</field>
            <field name="model">product.categ</field>
            <field name="arch" type="xml">
                <tree create="1">
                    <field name="name" string="Tên" optional="show" required="1"/>
                </tree>
            </field>
        </record>
        <record id="view_product_categ_form" model="ir.ui.view">
            <field name="name">product_categ_form</field>
            <field name="model">product.categ</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="name"/>
                        </group>
                    </sheet>
                </form></field>
        </record>


        <record id="action_product_categ" model="ir.actions.act_window">
            <field name="name">product categ</field>
            <field name="res_model">product.categ</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Tạo categ
                </p>
            </field>
        </record>

    </data>
</odoo>
