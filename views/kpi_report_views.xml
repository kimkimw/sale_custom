<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="seq_sale_kpi_report" model="ir.sequence">
            <field name="name">Sale KPI Report</field>
            <field name="code">sale.kpi.report</field>
            <field name="prefix"></field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="view_sale_kpi_report_tree" model="ir.ui.view">
            <field name="name">sale.kpi.report.tree</field>
            <field name="model">sale.kpi.report</field>
            <field name="arch" type="xml">
                <tree string="BÁO CÁO CÔNG VIỆC HẰNG NGÀY"
                      editable="bottom">
                    <field name="name" string="STT" optional="hide" readonly="1"/>
                    <field name="date_display" string="Ngày" readonly="1"/>
                    <field name="partner_id" options="{'no_create': True}" string="Tên Khách Hàng"
                           readonly="state != 'draft'"/>
                    <field name="description" string="Sản phẩm" readonly="state != 'draft'"/>
                    <field name="product_ids" optional="hide" string="Sản phẩm" readonly="state != 'draft'"
                           widget="many2many_tags"/>
                    <field name="product_categ_ids" widget="many2many_tags" string="Hình thức"
                           readonly="state != 'draft'"/>
                    <field name="quantity" string="Số lượng" sum="Tổng số lượng" readonly="state != 'draft'"/>
                    <field name="categ_count" string="Số lượt" sum="Tổng số lượt" readonly="state != 'draft'"/>
                    <field name="unit_price" string="Đơn giá" readonly="state != 'draft'"/>
                    <field name="total_amount" string="Thành tiền" readonly="state != 'draft'"
                            sum="Tổng doanh thu"/>
                    <field name="design_count" readonly="state != 'draft'" sum="Tổng thiết kế"/>
                    <field name="create_uid" string="Người tạo" readonly="1"/>
                    <field name="state" optional="show" widget="badge" string="Trạng thái"
                           decoration-muted="state == 'draft'" decoration-success="state == 'confirmed'"/>
                    <field name="write_uid" readonly="1" string="Người chỉnh sửa cuối cùng" optional="hide"/>
                    <button name="action_confirm" type="object" groups="base.group_system"
                            string="Xác nhận" icon="fa-check"
                            class="btn-success"
                            invisible="state == 'confirmed'"/>
                    <button name="action_reset_draft" type="object" groups="base.group_system"
                            string="Đặt lại nháp" icon="fa-undo"
                            invisible="state == 'draft'"/>
                    <field name="note" string="Ghi chú"/>
                </tree>
            </field>
        </record>


        <record id="view_sale_kpi_report_search" model="ir.ui.view">
            <field name="name">sale.kpi.report.search</field>
            <field name="model">sale.kpi.report</field>
            <field name="arch" type="xml">
                <search string="Tìm kiếm KPI">
                    <field name="name"/>
                    <field name="partner_id"/>
                    <field name="product_id"/>
                    <field name="user_id"/>
                    <field name="date"/>
                    <filter name="filter_today" string="Hôm nay"
                            domain="[('date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                    <filter name="filter_this_month" string="Tháng này"
                            domain="[('date', '&gt;=', (context_today().replace(day=1)).strftime('%Y-%m-%d'))]"/>
                    <separator/>
                    <filter name="filter_draft" string="Nháp"
                            domain="[('state', '=', 'draft')]"/>
                    <filter name="filter_confirmed" string="Đã xác nhận"
                            domain="[('state', '=', 'confirmed')]"/>
                    <filter name="filter_wrong" string="Sai đơn hàng"
                            domain="[('state', '=', 'wrong')]"/>
                    <separator/>
                    <filter name="filter_my" string="Của tôi"
                            domain="[('user_id', '=', uid)]"/>
                    <group expand="0" string="Nhóm theo">
                        <filter string="Ngày" name="group_date"
                                context="{'group_by': 'date'}"/>
                        <filter string="Khách hàng" name="group_partner"
                                context="{'group_by': 'partner_id'}"/>
                        <filter string="Nhân viên" name="group_user"
                                context="{'group_by': 'user_id'}"/>
                        <filter string="Trạng thái" name="group_state"
                                context="{'group_by': 'state'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="view_sale_kpi_report_pivot" model="ir.ui.view">
            <field name="name">sale.kpi.report.pivot</field>
            <field name="model">sale.kpi.report</field>
            <field name="arch" type="xml">
                <pivot string="Phân tích KPI">
                    <field name="date" type="row" interval="day"/>
                    <field name="user_id" type="col"/>
                    <field name="total_amount" type="measure"/>
                </pivot>
            </field>
        </record>

        <record id="view_sale_kpi_report_graph" model="ir.ui.view">
            <field name="name">sale.kpi.report.graph</field>
            <field name="model">sale.kpi.report</field>
            <field name="arch" type="xml">
                <graph string="Biểu đồ KPI" type="bar">
                    <field name="date" interval="day"/>
                    <field name="total_amount" type="measure"/>
                </graph>
            </field>
        </record>

        <record id="action_sale_kpi_report" model="ir.actions.act_window">
            <field name="name">Báo cáo công việc hằng ngày</field>
            <field name="res_model">sale.kpi.report</field>
            <field name="view_mode">tree,form,pivot,graph</field>
            <field name="context">{'search_default_filter_today': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Tạo báo cáo công việc hằng ngày
                </p>
            </field>
        </record>

    </data>
</odoo>
