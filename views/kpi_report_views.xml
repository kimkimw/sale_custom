<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>


        <record id="view_sale_kpi_report_tree" model="ir.ui.view">
            <field name="name">sale.kpi.report.tree</field>
            <field name="model">sale.kpi.report</field>
            <field name="arch" type="xml">
                <tree string="BÁO CÁO CÔNG VIỆC HẰNG NGÀY"
                      editable="bottom"
                      decoration-success="state == 'confirmed'"
                      decoration-danger="state == 'wrong'"
                      decoration-muted="state == 'draft'">
                    <field name="sequence" widget="handle"/>
                    <field name="name" string="STT" optional="show" readonly="1"/>
                    <field name="date" string="Ngày" readonly="state != 'draft'" optional="hide"/>
                    <field name="partner_id" string="Tên Khách Hàng" readonly="state != 'draft'"/>
                    <field name="product_ids" string="Sản phẩm" readonly="state != 'draft'" widget="many2many_tags"/>
                    <field name="form_type" string="Hình thức" readonly="state != 'draft'" optional="hide"/>
                    <field name="description" string="Diễn giải" readonly="state != 'draft'" width="500px"/>
                    <field name="quantity" string="Số lượng" sum="Tổng số lượng" readonly="state != 'draft'"/>
                    <field name="turn_count" string="Số lượt" sum="Tổng lượt" readonly="state != 'draft'"/>
                    <field name="unit_price" string="Đơn giá" widget="monetary" readonly="state != 'draft'"/>
                    <field name="total_amount" string="Thành tiền" readonly="state != 'draft'"
                           widget="monetary" sum="Tổng doanh thu"/>
                    <field name="note" string="Ghi chú"/>
                    <field name="state" optional="show" widget="badge"/>
                    <field name="currency_id" column_invisible="True"/>
                    <field name="create_uid" readonly="1" string="Người tạo" optional="hide"/>
                    <field name="write_uid" readonly="1" string="Người chỉnh sửa cuối cùng" optional="hide"/>
                    <button name="action_confirm" type="object" groups="base.group_system"
                            string="Xác nhận" icon="fa-check"
                            class="btn-success"
                            invisible="state == 'confirmed'"/>
                    <button name="action_mark_wrong" type="object" groups="base.group_system"
                            string="Sai đơn hàng" icon="fa-times"
                            class="btn-danger"
                            invisible="state in ('wrong','draft')"/>
                    <button name="action_reset_draft" type="object" groups="base.group_system"
                            string="Đặt lại nháp" icon="fa-undo"
                            invisible="state == 'draft'"/>
                </tree>
            </field>
        </record>

        <record id="view_sale_kpi_report_form" model="ir.ui.view">
            <field name="name">sale.kpi.report.form</field>
            <field name="model">sale.kpi.report</field>
            <field name="arch" type="xml">
                <form string="Báo cáo công việc">
                    <header>
                        <button name="action_confirm" type="object"
                                string="Xác nhận" class="btn-success"
                                invisible="state == 'confirmed'"/>
                        <button name="action_mark_wrong" type="object"
                                string="Sai đơn hàng" class="btn-danger"
                                invisible="state == 'wrong'"/>
                        <button name="action_reset_draft" type="object"
                                string="Đặt lại nháp"
                                invisible="state == 'draft'"/>
                        <field name="state" widget="statusbar"
                               statusbar_visible="draft,confirmed"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" readonly="1"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="date"/>
                                <field name="partner_id"
                                       options="{'no_create': True}"/>
                                <field name="partner_phone"/>
                                <field name="user_id"/>
                            </group>
                            <group>
                                <field name="product_id"
                                       domain="[('sale_ok', '=', True)]"
                                       options="{'no_create': True}"/>
                                <field name="form_type"/>
                                <field name="description"/>
                                <field name="sale_order_id"/>
                            </group>
                        </group>
                        <group string="Số liệu">
                            <group>
                                <field name="quantity"/>
                                <field name="turn_count"/>
                            </group>
                            <group>
                                <field name="unit_price" widget="monetary"/>
                                <field name="total_amount" widget="monetary"/>
                                <field name="currency_id" invisible="1"/>
                            </group>
                        </group>
                        <group>
                            <field name="note"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_sale_kpi_report_search" model="ir.ui.view">
            <field name="name">sale.kpi.report.search</field>
            <field name="model">sale.kpi.report</field>
            <field name="arch" type="xml">
                <search string="Tìm kiếm KPI">
                    <field name="name"/>
                    <field name="partner_id"/>
                    <field name="product_id"/>
                    <field name="user_id"/>
                    <field name="date"/>
                    <filter name="filter_today" string="Hôm nay"
                            domain="[('date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                    <filter name="filter_this_month" string="Tháng này"
                            domain="[('date', '&gt;=', (context_today().replace(day=1)).strftime('%Y-%m-%d'))]"/>
                    <separator/>
                    <filter name="filter_draft" string="Nháp"
                            domain="[('state', '=', 'draft')]"/>
                    <filter name="filter_confirmed" string="Đã xác nhận"
                            domain="[('state', '=', 'confirmed')]"/>
                    <filter name="filter_wrong" string="Sai đơn hàng"
                            domain="[('state', '=', 'wrong')]"/>
                    <separator/>
                    <filter name="filter_my" string="Của tôi"
                            domain="[('user_id', '=', uid)]"/>
                    <group expand="0" string="Nhóm theo">
                        <filter string="Ngày" name="group_date"
                                context="{'group_by': 'date'}"/>
                        <filter string="Khách hàng" name="group_partner"
                                context="{'group_by': 'partner_id'}"/>
                        <filter string="Nhân viên" name="group_user"
                                context="{'group_by': 'user_id'}"/>
                        <filter string="Trạng thái" name="group_state"
                                context="{'group_by': 'state'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="view_sale_kpi_report_pivot" model="ir.ui.view">
            <field name="name">sale.kpi.report.pivot</field>
            <field name="model">sale.kpi.report</field>
            <field name="arch" type="xml">
                <pivot string="Phân tích KPI">
                    <field name="date" type="row" interval="day"/>
                    <field name="user_id" type="col"/>
                    <field name="turn_count" type="measure"/>
                    <field name="total_amount" type="measure"/>
                </pivot>
            </field>
        </record>

        <record id="view_sale_kpi_report_graph" model="ir.ui.view">
            <field name="name">sale.kpi.report.graph</field>
            <field name="model">sale.kpi.report</field>
            <field name="arch" type="xml">
                <graph string="Biểu đồ KPI" type="bar">
                    <field name="date" interval="day"/>
                    <field name="total_amount" type="measure"/>
                </graph>
            </field>
        </record>

        <record id="action_sale_kpi_report" model="ir.actions.act_window">
            <field name="name">Báo cáo công việc hằng ngày</field>
            <field name="res_model">sale.kpi.report</field>
            <field name="view_mode">tree,form,pivot,graph</field>
            <field name="context">{'search_default_filter_today': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Tạo báo cáo công việc hằng ngày
                </p>
            </field>
        </record>

    </data>
</odoo>
